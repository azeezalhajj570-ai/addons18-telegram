<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bpmn_workflow_tree" model="ir.ui.view">
        <field name="name">bpmn.workflow.tree</field>
        <field name="model">bpmn.workflow</field>
        <field name="arch" type="xml">
            <tree string="BPMN Workflows">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_bpmn_workflow_form" model="ir.ui.view">
        <field name="name">bpmn.workflow.form</field>
        <field name="model">bpmn.workflow</field>
        <field name="arch" type="xml">
            <form string="BPMN Workflow">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="xml_content" widget="bpmn_field"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bpmn_workflow" model="ir.actions.act_window">
        <field name="name">BPMN Workflows</field>
        <field name="res_model">bpmn.workflow</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_bpmn_root" name="BPMN" web_icon="bpmn_widget,static/description/icon.png"/>
    <menuitem id="menu_bpmn_workflow" name="Workflows" parent="menu_bpmn_root" action="action_bpmn_workflow"/>

</odoo>
