<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_ocr_document_list" model="ir.ui.view">
        <field name="name">ocr.document.list</field>
        <field name="model">ocr.document</field>
        <field name="arch" type="xml">
            <list string="OCR Documents">
                <field name="name"/>
                <field name="scan_mode"/>
                <field name="element_type" optional="hide"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ocr_document_form" model="ir.ui.view">
        <field name="name">ocr.document.form</field>
        <field name="model">ocr.document</field>
        <field name="arch" type="xml">
            <form string="OCR Document">
                <header>
                    <button name="action_scan_ocr" string="Scan / Parse" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    
                    <div class="row">
                        <!-- Left Column: Controls & Preview -->
                        <div class="col-md-5">
                            <group string="Configuration">
                                <field name="scan_mode" widget="radio" options="{'horizontal': true}"/>
                                
                                <!-- Document Parsing Options -->
                                <field name="use_doc_unwarping" invisible="scan_mode != 'document'"/>
                                <field name="use_doc_orientation_classify" invisible="scan_mode != 'document'"/>
                                <field name="use_chart_recognition" invisible="scan_mode != 'document'"/>
                                
                                <!-- Element Options -->
                                <field name="element_type" invisible="scan_mode != 'element'"/>
                            </group>
                            
                            <separator string="Document Upload"/>
                            <field name="mimetype" invisible="1"/>
                            <field name="filename" invisible="1"/>
                            <!-- Use standard binary with image preview -->
                            <field name="file" filename="filename" widget="image" options="{'size': [0, 0]}" invisible="mimetype != 'image'" style="width: 100%; max-height: 500px; object-fit: contain; margin-top: 10px;"/>
                            <field name="file" filename="filename" widget="pdf_viewer" invisible="mimetype != 'pdf'" style="height: 500px;"/>
                            <field name="file" filename="filename" invisible="mimetype in ['image', 'pdf']"/>
                        </div>
                        
                        <!-- Right Column: Results Tabs -->
                        <div class="col-md-7">
                             <notebook>
                                <page string="Markdown Preview">
                                    <!-- Use html widget to render markdown (Odoo support is limited but let's try or use field widget) -->
                                    <field name="ocr_markdown" widget="html" options="{'style': 'height: 600px; overflow-y: auto;'}"/>
                                    <!-- Fallback prompt -->
                                    <div invisible="ocr_markdown" class="text-muted text-center" style="padding: 20px;">
                                        Please upload an image and click 'Scan / Parse'.
                                    </div>
                                </page>
                                
                                <page string="Visualization">
                                    <field name="annotated_file" widget="image" options="{'size': [0, 0]}" nolabel="1" style="width: 100%; max-height: 800px; object-fit: contain; display: block;"/>
                                     <div invisible="annotated_file" class="text-muted text-center" style="padding: 20px;">
                                        Visualization will appear here after scanning.
                                    </div>
                                </page>
                                
                                <page string="Markdown Source">
                                    <field name="ocr_markdown" style="font-family: monospace; min-height: 500px;"/>
                                </page>
                                
                                <page string="Raw JSON" groups="base.group_no_one">
                                    <field name="ocr_json_response"/>
                                </page>
                            </notebook>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ocr_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">ocr.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_ocr_documents"
              name="Documents"
              parent="menu_ocr_root"
              action="action_ocr_document"
              sequence="1"/>

</odoo>
