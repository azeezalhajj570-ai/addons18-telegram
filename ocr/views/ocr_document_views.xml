<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_ocr_document_list" model="ir.ui.view">
        <field name="name">ocr.document.list</field>
        <field name="model">ocr.document</field>
        <field name="arch" type="xml">
            <list string="OCR Documents">
                <field name="name"/>
                <field name="scan_mode"/>
                <field name="element_type" optional="hide"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ocr_document_form" model="ir.ui.view">
        <field name="name">ocr.document.form</field>
        <field name="model">ocr.document</field>
        <field name="arch" type="xml">
            <form string="OCR Document">
                <header>
                    <button name="action_scan_ocr" string="Scan / Parse" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    
                    <div class="row">
                        <!-- Left Column: Source Image -->
                        <div class="col-md-6" style="border-right: 1px solid #ccc; padding-right: 15px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-muted">Source Image</strong>
                            </div>
                            
                            <group invisible="1">
                                <field name="mimetype" invisible="1"/>
                                <field name="filename" invisible="1"/>
                            </group>
                            
                            <!-- Source HTML (Identical structure to Right Side) -->
                            <!-- Removed active scrolling: images will expand to full height -->
                            <field name="ocr_source_html" widget="html" nolabel="1" options="{'style': 'width: 100%; border: 1px solid #eee; background: #fafafa;'}" invisible="mimetype != 'image'"/>

                            <!-- PDF Viewer Fallback -->
                            <field name="file" filename="filename" widget="pdf_viewer" invisible="mimetype != 'pdf'" style="height: 800px; width: 100%;"/>
                            
                            <!-- Initial Fallback / Upload Widget -->
                            <!-- Show standard file upload widget if no file is present -->
                            <div invisible="file" class="text-center mt-4 p-4" style="border: 2px dashed #ccc; border-radius: 8px; background: #f8f9fa;">
                                <div class="mb-3"><i class="fa fa-cloud-upload fa-3x text-muted"/></div>
                                <div class="mb-2"><strong>Upload Document</strong></div>
                                <field name="file" filename="filename" widget="binary" nolabel="1"/>
                            </div>
                        </div>
                        
                        <!-- Right Column: Interactive Result -->
                        <div class="col-md-6" style="padding-left: 15px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong class="text-muted">Interactive Result</strong>
                                <span class="badge text-bg-warning" invisible="not ocr_visualization_html">Hover to Select</span>
                            </div>

                            <field name="ocr_visualization_html" widget="html" nolabel="1" options="{'style': 'width: 100%; border: 1px solid #eee; background: #fafafa;'}"/>
                            
                            <div invisible="ocr_visualization_html" class="text-muted text-center d-flex align-items-center justify-content-center" style="height: 400px; background: #f8f9fa; border: 1px dashed #dee2e6;">
                                <span><i class="fa fa-magic"/> Scan document to generate interactive overlay</span>
                            </div>
                        </div>
                    </div>

                    <!-- Configuration and Raw Data (Below Fold) -->
                    <group string="Configuration &amp; Data" col="4">
                        <field name="scan_mode" widget="radio" options="{'horizontal': true}"/>
                        <field name="use_doc_unwarping" invisible="scan_mode != 'document'"/>
                        <field name="use_doc_orientation_classify" invisible="scan_mode != 'document'"/>
                        <field name="use_chart_recognition" invisible="scan_mode != 'document'"/>
                        <field name="element_type" invisible="scan_mode != 'element'"/>
                    </group>

                    <notebook>
                        <page string="Markdown Text">
                            <field name="ocr_markdown" widget="html" options="{'style': 'height: 300px; overflow-y: auto;'}"/>
                        </page>
                        <page string="JSON Output">
                             <group>
                                <field name="ocr_json_filename" invisible="1"/>
                                <div class="alert alert-info" role="alert" invisible="not ocr_json_file">
                                    <h4 class="alert-heading">JSON Analysis Ready</h4>
                                    <p>Download the full structural analysis containing text, coordinates, and confidence scores.</p>
                                    <hr/>
                                    <field name="ocr_json_file" filename="ocr_json_filename" widget="binary" readonly="1"/>
                                </div>
                                <div invisible="ocr_json_file" class="text-muted">
                                    No JSON analysis available yet. Scan a document to generate.
                                </div>
                            </group>
                            <group string="Raw Content" groups="base.group_no_one">
                                <field name="ocr_json_response"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ocr_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">ocr.document</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_ocr_documents"
              name="Documents"
              parent="menu_ocr_root"
              action="action_ocr_document"
              sequence="1"/>

</odoo>
