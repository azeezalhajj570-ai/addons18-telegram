<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_ocr_document_tree" model="ir.ui.view">
        <field name="name">ocr.document.tree</field>
        <field name="model">ocr.document</field>
        <field name="arch" type="xml">
            <tree string="OCR Documents">
                <field name="name"/>
                <field name="filename"/>
                <field name="create_date"/>
                <field name="ocr_confidence" widget="progressbar"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_ocr_document_form" model="ir.ui.view">
        <field name="name">ocr.document.form</field>
        <field name="model">ocr.document</field>
        <field name="arch" type="xml">
            <form string="OCR Document">
                <header>
                    <button name="action_scan_ocr" string="Scan Document" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    
                    <div class="row">
                        <!-- Left Column: Document Preview -->
                        <div class="col-md-6">
                            <label for="file" string="Document"/>
                            <!-- Use pdf_viewer for PDF support, generic binary for others -->
                            <field name="file" filename="filename" widget="pdf_viewer"/>
                            <field name="filename" invisible="1"/>
                        </div>
                        
                        <!-- Right Column: Results -->
                        <div class="col-md-6">
                             <separator string="OCR Results"/>
                             <group>
                                <field name="ocr_confidence"/>
                             </group>
                             <label for="ocr_raw_text"/>
                             <field name="ocr_raw_text" placeholder="Extracted text will appear here..."/>
                             
                             <group col="1">
                                <label for="ocr_json_response" groups="base.group_no_one"/>
                                <field name="ocr_json_response" groups="base.group_no_one" nolabel="1"/>
                             </group>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ocr_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">ocr.document</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Upload a document to start scanning.
          </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_ocr_documents"
              name="Documents"
              parent="menu_ocr_root"
              action="action_ocr_document"
              sequence="1"/>

</odoo>
