<odoo>
    <record id="view_telegram_bot_form" model="ir.ui.view">
        <field name="name">telegram.bot.form</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_webhook"
                            type="object"
                            string="Set Webhook"
                            class="oe_highlight"/>
                    <button name="action_delete_webhook"
                            type="object"
                            string="Delete Webhook"
                            class="oe_highlight"/>
                    <button name="action_get_webhook_info"
                            type="object"
                            string="Get Webhook Info"
                            class="oe_highlight"/>

                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="token" password="True"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Flows">
                            <field name="flow_ids"/>
                        </page>
                        <page string="Webhook">
                             <field name="webhook_config_id"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_telegram_bot_list" model="ir.ui.view">
        <field name="name">telegram.bot.list</field>
            <field name="model">telegram.bot</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
    </record>



    <record id="action_telegram_bot" model="ir.actions.act_window">
        <field name="name">Bots</field>
        <field name="res_model">telegram.bot</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="telegram_bot_menu"
              parent="telegram_root_menu"
              name="Bots"
              action="action_telegram_bot"/>
</odoo>
