<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ocr" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ocr</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_scan_ocr" string="Scan OCR" type="object" class="oe_highlight" groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="OCR Debug" name="ocr_debug" groups="base.group_no_one">
                    <group>
                        <field name="ocr_confidence"/>
                        <field name="ocr_raw_text"/>
                        <field name="ocr_json_response"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
