<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ocr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div data-key="account" class="app_settings_block" data-string="Accounting">
                    <h2>OCR Integration</h2>
                    <div class="row mt16 o_settings_container" id="ocr_settings">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="ocr_api_endpoint"/>
                                <div class="text-muted">
                                    Endpoint to send invoices to (e.g. http://localhost:8000/ocr)
                                </div>
                                <field name="ocr_api_endpoint"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
